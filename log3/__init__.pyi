class Tensor:
    """64-byte aligned N-dimensional Tensor supporting scalar & BitNet sub-byte DTypes,
    zero-copy PEP 3118 buffer export (`memoryview(t)`, `np.asarray(t)`), and Autograd.
    """

    def __init__(
        self,
        shape: Optional[ShapeLike] = None,
        dtype: DTypeLike = "f32",
        requires_grad: bool = False,
    ) -> None: ...
    @property
    def shape(self) -> Tuple[int, ...]: ...
    @property
    def strides(self) -> Tuple[int, ...]: ...
    @property
    def ndim(self) -> int: ...
    @property
    def rank(self) -> int: ...
    @property
    def numel(self) -> int: ...
    @property
    def nbytes(self) -> int: ...
    @property
    def byte_offset(self) -> int: ...
    @property
    def dtype(self) -> str: ...
    @property
    def is_contiguous(self) -> bool: ...
    @property
    def is_mutable(self) -> bool: ...
    @property
    def is_quantized(self) -> bool: ...
    @property
    def quant_scale(self) -> float: ...
    @quant_scale.setter
    def quant_scale(self, value: float) -> None: ...
    @property
    def requires_grad(self) -> bool: ...
    @requires_grad.setter
    def requires_grad(self, value: bool) -> None: ...
    @property
    def is_leaf(self) -> bool: ...
    @property
    def has_grad(self) -> bool: ...
    @property
    def grad(self) -> Optional["Tensor"]: ...
    def view(self) -> "Tensor": ...
    def detach(self) -> "Tensor": ...
    def clone(self) -> "Tensor": ...
    def contiguous(self) -> "Tensor": ...
    def reshape(self, shape: ShapeLike) -> "Tensor": ...
    def transpose(self, dim0: int, dim1: int) -> "Tensor": ...
    def permute(self, dims: Sequence[int]) -> "Tensor": ...
    def slice(self, axis: int, start: int, end: int) -> "Tensor": ...
    def unsqueeze(self, axis: int) -> "Tensor": ...
    def squeeze(self, axis: int = -999) -> "Tensor": ...
    def backward(self, grad_output: Optional["Tensor"] = None) -> None: ...
    def zero_grad(self) -> None: ...
    def fill_(self, value: float) -> "Tensor": ...
    def to_list(self) -> List[Union[float, int]]: ...
    def item(self) -> Union[float, int]: ...
    def __add__(self, other: "Tensor") -> "Tensor": ...
    def __sub__(self, other: "Tensor") -> "Tensor": ...
    def __mul__(self, other: "Tensor") -> "Tensor": ...
    def __matmul__(self, other: "Tensor") -> "Tensor": ...
    def __buffer__(self, flags: int) -> memoryview: ...

